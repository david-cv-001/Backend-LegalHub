# Database
DB_NAME=legalhub
DB_USERNAME=legalhub
DB_PASSWORD=legalhub
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/legalhub

# Server
SERVER_PORT=8080

# JWT - use a secret with at least 32 bytes in production
JWT_SECRET=dev-secret-change-me-please-use-32-bytes-minimum
JWT_EXPIRATION_SECONDS=28800

# Default superadmin (seeded only if it does not exist)
SUPERADMIN_USERNAME=admin@unsis.com
SUPERADMIN_PASSWORD=admin123
SUPERADMIN_SYNC_PASSWORD=false

# Frontend origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Demo data, only used with the dev profile
DEMO_DATA_ENABLED=false
